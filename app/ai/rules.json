  "source": "https://seller.uzum.uz/manual/5.product-creation/",
  "sections": ["5.1", "5.3", "5.6", "5.8", "5.9"],
  "verified_requirements": {
    "languages": ["uz-Latn", "ru-Cyrl"],
    "title_scheme": "product type + brand + model + key characteristic",
    "title_minimum_words": 3,
    "title_allowed_symbols": ", . : ; - – ( ) / “” % x *",
    "title_starts_uppercase": true,
    "no_title_emoji": true,
    "no_capslock_except_brand_model": true,
    "no_external_links_or_personal_contacts": true,
    "no_subjective_claims_about_reviews_rating_or_popularity": true,
    "no_medical_or_treatment_claims": true,
    "short_description_sentences": "1-2",
    "stop_words_allowed_when_part_of_product_brand_or_model": true,
    "unlimited_shelf_life_items_need_warranty_information": true
  },
  "unverified": ["maximum text lengths in seller cabinet", "category-specific import templates"],
  "internal_limits": {"title": 200, "short_description": 1000, "description": 10000},
  "stop_patterns": [

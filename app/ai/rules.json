    "\\bтренд\\w*", "\\bтоп\\b", "\\bхит(ы)?\\b", "\\bдешев\\w*", "\\bдешёв\\w*", "\\bдорого\\b", "\\bдороже\\b",
    "\\bсамый дорогой\\b", "\\b(высокая|выгодная|доступная|идеальная|низкая|отличная|супер|топ) цен\\w*",
    "\\bлучш\\w*", "\\bлидер продаж\\b", "\\bномер 1\\b", "№\\s*1\\b", "\\bтолько у нас\\b", "\\bтовар года\\b",
    "\\bнет аналогов\\b", "\\bне как у конкурентов\\b", "\\bвсе выбирают\\b", "\\bnew\\b", "\\bsale\\b",
    "\\baksiya\\w*", "\\bbepul\\w*", "\\bbuyurtma (qiling|bering)\\b", "\\bsotib oling\\b", "\\bxarid qiling\\b",
    "\\bkeshbek\\w*", "\\byangilik\\w*", "\\boriginal\\w*", "\\bchegirma\\w*", "\\btrend\\w*", "\\bx?hit\\b",

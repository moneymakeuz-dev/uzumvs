# Copy to .env and fill values. Never commit real secrets.
APP_ENV=production
APP_BASE_URL=https://cards.example.uz
ALLOWED_HOSTS=cards.example.uz
DOMAIN=cards.example.uz
POSTGRES_PASSWORD=

AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Set only after reading https://ai.google.dev/gemini-api/terms for your billing tier.
AI_TERMS_ACCEPTED=false
AI_DAILY_BUDGET_USD=
# USD per 1M tokens, copied from https://ai.google.dev/gemini-api/docs/pricing on the date below.
AI_INPUT_PRICE_PER_MILLION=0.30
AI_OUTPUT_PRICE_PER_MILLION=2.50
AI_PRICE_VERSION=gemini-2.5-flash-2026-09-28

MAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Karto <no-reply@example.uz>
SMTP_STARTTLS=true

# Generate with: docker compose run --rm ops karto create-backup-key
BACKUP_KEY=
BACKUP_BUCKET=
BACKUP_PREFIX=karto
BACKUP_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
ALERT_WEBHOOK_URL=
